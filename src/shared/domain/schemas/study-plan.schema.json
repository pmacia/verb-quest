{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verbquest.example/schemas/study-plan.schema.json",
  "title": "VerbQuest Study Plan",
  "type": "object",
  "required": ["id", "name", "source", "goals", "schedule", "createdAt"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "source": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["course", "saved_list", "manual", "filter", "imported"] },
        "course": { "enum": ["eso1", "eso2", "eso3", "eso4"] },
        "listId": { "type": "string" },
        "verbIds": { "type": "array", "items": { "type": "string" } },
        "filter": { "type": "object" }
      },
      "additionalProperties": false
    },
    "goals": {
      "type": "array",
      "items": {
        "enum": ["learn", "review", "listening", "spelling", "pronunciation", "context", "mixed"]
      },
      "minItems": 1
    },
    "schedule": {
      "type": "object",
      "required": ["minutesPerSession", "newVerbsPerSession"],
      "properties": {
        "minutesPerSession": { "enum": [5, 10, 15] },
        "newVerbsPerSession": { "type": "integer", "minimum": 0, "maximum": 30 },
        "daysPerWeek": {
          "type": "array",
          "items": { "enum": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"] }
        },
        "remindersEnabled": { "type": "boolean", "default": false }
      },
      "additionalProperties": false
    },
    "questionModes": {
      "type": "array",
      "items": {
        "enum": [
          "flashcards",
          "matching",
          "audio_detective",
          "quiz",
          "word_builder",
          "sentence_gap",
          "error_hunter",
          "pronunciation_lab",
          "final_challenge"
        ]
      }
    },
    "isTemplate": { "type": "boolean", "default": false },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
